  "keyFeatures": [
    "System provisioning and lifecycle management",
    "Operator dashboard with real-time system status",
    "Builder tools for constructing and configuring systems",
    "Role-based access for operators and builders",
    "Webhook integrations for external system events",
    "REST API for programmatic system management",
    "Monitoring and observability for running systems",
    "API key management for secure access"
  ],
  "publicApiSurface": [
    "GET /systems — list all systems",
    "POST /systems — provision a new system",
    "PUT /systems/{id} — update system configuration",
    "DELETE /systems/{id} — deprovision a system",
    "GET /operators — list operators",
    "GET /builders — list builders",
    "POST /api-keys — create API key",
    "POST /webhooks — register a webhook endpoint"
  ]
